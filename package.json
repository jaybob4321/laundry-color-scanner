{
  "name": "laundry-color-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first PWA that names a garment's color and suggests a laundry sorting group using on-device image analysis.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/integration/**/*.test.mjs\"",
    "test:e2e": "node scripts/run-e2e.mjs chromium",
    "test:e2e:webkit": "node scripts/run-e2e.mjs webkit",
    "bench": "node scripts/bench.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "profiles": "node scripts/build-reference-profiles.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
